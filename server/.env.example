# DM3A Grader server — environment variables.
# Copy to .env and fill in. NEVER commit the real .env (it is git-ignored).

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@dm3a.xpvurgj.mongodb.net/dm3a?appName=dm3a

# ── Grading ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Instructor accounts (added with the accounts feature) ────────────────────
# Signs the session cookie. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out. Auth FAILS CLOSED when this is unset.
# HUB_JWT_SECRET is the current name (shared by every *.dm3agrader.com tool);
# JWT_SECRET is read only as a fallback during the rename. Same value in both.
HUB_JWT_SECRET=

# ── Google sign-in (existing accounts only — never creates one) ─────────────
# Web OAuth client id from Google Cloud Console. Public, not a secret. The
# frontend needs the same value as VITE_GOOGLE_CLIENT_ID. Unset => Google
# sign-in is refused (fail closed); email+password keeps working.
GOOGLE_CLIENT_ID=
# allowlist (default) or open. Anything other than "open" means allowlist.
SIGNUP_MODE=allowlist
# Comma-separated addresses allowed to use Google sign-in in allowlist mode.
ALLOWED_EMAILS=

# The old shared app password, kept as a migration fallback and as the
# break-glass for a database outage (accounts need Mongo; grading does not).
# Set ALLOW_LEGACY_LOGIN=false to retire it — no code change, no redeploy.
# Anything other than the exact string "true" leaves it OFF.
ALLOW_LEGACY_LOGIN=true
LEGACY_SHARED_PASSWORD=

# Base URL used to build password-reset links in emails.
APP_BASE_URL=https://dm3agrader.com

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Sends password-reset links and at-risk alerts, from support@dm3agrader.com.
# When unset, reset links are printed to the server console instead of emailed
# (that is the intended local-development behavior).
RESEND_API_KEY=

# ── At-Risk Bridge (Phase 2) — accepts records from DM3A CheckPoint ─────────
# Shared secret guarding POST /api/risk/bridge. Must match RISK_BRIDGE_KEY in
# CheckPoint's server/.env. UNSET => the endpoint is LOCKED (fails closed), and
# CheckPoint's records queue and retry rather than being lost.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RISK_BRIDGE_KEY=

# ── Redis (Upstash) — student access codes, trial passwords, rate limiting ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Admin dashboard + alerts ────────────────────────────────────────────────
ADMIN_DASHBOARD_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FRONTEND_URL=https://dm3agrader.com
