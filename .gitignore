# Environment variables — never commit secrets (MONGODB_URI, API keys, etc.)
.env
.env.*
!.env.example

# Stray Tesseract language data in the repo root. The copy the app actually uses
# is server/eng.traineddata, which IS committed (Railway needs it at runtime with
# no download). Leading slash = root only, so it never matches the server copy.
/eng.traineddata

